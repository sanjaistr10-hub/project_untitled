# Copy to .env.local and adjust. Defaults below match the backend's dev profile.

# Where the Spring Boot API runs. The browser never calls it directly: /api/* is proxied by Next.js
# (next.config.ts) so auth cookies stay first-party on each white-label domain.
BACKEND_URL=http://localhost:8081

# Host that serves the creator studio. Communities live on {slug}.ROOT_DOMAIN; any other host is
# treated as a custom domain and looked up via the API. Include the port in development.
ROOT_DOMAIN=localhost:3100
